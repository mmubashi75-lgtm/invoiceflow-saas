# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Paddle → Developer Tools → Authentication (Client-side token)
VITE_PADDLE_CLIENT_TOKEN=YOUR_PADDLE_CLIENT_TOKEN
VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle Catalog → Prices (monthly recurring)
VITE_PADDLE_PRICE_STARTER=pri_starter_xxxxx
VITE_PADDLE_PRICE_PRO=pri_pro_xxxxx
VITE_PADDLE_PRICE_BUSINESS=pri_business_xxxxx

# Optional
VITE_SUPPORT_EMAIL=mmubashi75@gmail.com
VITE_APP_NAME=InvoiceFlow

# Optional invoice email (https://resend.com)
VITE_RESEND_API_KEY=
VITE_RESEND_FROM=InvoiceFlow <onboarding@resend.dev>
